# Gemini — TEXT / image reasoning only (never used for STT audio)
GEMINI_API_KEY=your_key_here

# Local Whisper (required for speech-to-text)
# Option A: OpenAI-compatible whisper.cpp server
LOCAL_WHISPER_URL=http://127.0.0.1:8080/v1/audio/transcriptions

# Option B: whisper.cpp CLI binary + model
# WHISPER_CLI=C:\path\to\whisper-cli.exe
# WHISPER_MODEL=C:\path\to\ggml-base.en.bin
