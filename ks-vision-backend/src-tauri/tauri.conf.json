{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ks-vision-backend",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../../ks-vision/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../ks-vision && npm run dev",
    "beforeBuildCommand": "cd ../ks-vision && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KS Vision",
        "width": 420,
        "height": 600,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}