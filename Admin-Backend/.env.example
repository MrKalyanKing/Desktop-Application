PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5175,http://localhost:5174,http://localhost:5173

DATABASE_URL=postgres://parakeet:parakeet@localhost:5432/parakeet_admin
DATABASE_SSL=false
TYPEORM_SYNC=true
TYPEORM_LOGGING=false

JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=storage
# STORAGE_PROVIDER=s3
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

UPLOAD_MAX_BYTES=10485760
TRANSCRIPT_RETENTION_DAYS=365
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
